{
  "name": "Weekly Analytics Summary",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 1",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_analytics_summary",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_summary": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "weekly-analytics-summary",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send weekly site summary email",
            "description": "Traffic, signups, orders, engagement"
          }
        }
      }
    ]
  },
  "description": "Every Monday at 9am (America/Chicago), compiles the last 7 days of site traffic, signups, orders, and community engagement from the app's own tracked data and emails a summary to the admin."
}