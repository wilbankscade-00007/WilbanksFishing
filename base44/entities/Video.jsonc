{
  "name": "Video",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Video Title"
    },
    "youtube_url": {
      "type": "string",
      "title": "YouTube URL"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "title": "Display Order"
    }
  },
  "required": [
    "title",
    "youtube_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}