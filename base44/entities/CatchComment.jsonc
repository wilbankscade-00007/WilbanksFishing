{
  "name": "CatchComment",
  "type": "object",
  "properties": {
    "catch_id": {
      "type": "string",
      "title": "Catch ID"
    },
    "text": {
      "type": "string",
      "title": "Comment"
    },
    "author_id": {
      "type": "string",
      "title": "Author ID"
    },
    "author_name": {
      "type": "string",
      "title": "Author Name"
    }
  },
  "required": [
    "catch_id",
    "text",
    "author_id",
    "author_name"
  ],
  "rls": {
    "create": {
      "data.author_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.author_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}