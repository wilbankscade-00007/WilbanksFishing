{
  "name": "TypingStatus",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User ID"
    },
    "author_name": {
      "type": "string",
      "title": "Author Name"
    },
    "last_typed": {
      "type": "string",
      "format": "date-time",
      "title": "Last Typed"
    }
  },
  "required": [
    "user_id",
    "last_typed"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}