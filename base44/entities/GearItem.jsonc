{
  "name": "GearItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Gear Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "image_url": {
      "type": "string",
      "format": "uri",
      "title": "Image URL"
    },
    "link_url": {
      "type": "string",
      "format": "uri",
      "title": "Purchase / Info Link"
    },
    "category": {
      "type": "string",
      "default": "General",
      "title": "Category"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "title": "Display Order"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}