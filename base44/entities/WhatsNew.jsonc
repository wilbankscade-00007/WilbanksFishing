{
  "name": "WhatsNew",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "link_url": {
      "type": "string",
      "title": "Link URL"
    },
    "icon": {
      "type": "string",
      "enum": [
        "video",
        "merch",
        "tip",
        "bts",
        "gallery",
        "other"
      ],
      "default": "other",
      "title": "Icon Type"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "title": "Display Order"
    }
  },
  "required": [
    "title",
    "description"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}