{
  "name": "MemberCatch",
  "type": "object",
  "properties": {
    "image_url": {
      "type": "string",
      "format": "uri",
      "title": "Image URL"
    },
    "caption": {
      "type": "string",
      "title": "Caption"
    },
    "gear_used": {
      "type": "string",
      "title": "Gear Used"
    },
    "species": {
      "type": "string",
      "title": "Species"
    },
    "author_id": {
      "type": "string",
      "title": "Author ID"
    },
    "author_name": {
      "type": "string",
      "title": "Author Name"
    }
  },
  "required": [
    "image_url",
    "author_id",
    "author_name"
  ],
  "rls": {
    "create": {
      "data.author_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.author_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.author_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}